# OCLC WSKey credentials. Request from OCLC; the WSKey must have CCG
# (client_credentials) enabled and the policiesDirectoryAPI scope.
OCLC_WSKEY=
OCLC_SECRET=

# Your OCLC institution ID (the number shown next to your library in the
# WSKey panel — e.g. 8995 for Leon County Public Library System).
OCLC_CONTEXT_INSTITUTION_ID=

# Space-separated WSKey scopes to request. Defaults to the Policies Directory
# only. Add IFM and/or articleExchange if you start calling those APIs.
OCLC_SCOPES=policiesDirectoryAPI

# CORS — set to your Pages site origin in production. Use * during local dev.
# Example for production: https://your-user.github.io
ALLOWED_ORIGIN=*

# How long to cache OCLC responses in memory. Default 24 hours.
# Policy data changes slowly; longer cache = fewer API calls.
CACHE_TTL_SECONDS=86400
