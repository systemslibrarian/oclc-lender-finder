# OCLC WSKey credentials. Request from OCLC; needs scopes for
# Library Profiles + ILL Policies Directory.
OCLC_WSKEY=
OCLC_SECRET=

# CORS — set to your Pages site origin in production. Use * during local dev.
# Example for production: https://your-user.github.io
ALLOWED_ORIGIN=*

# How long to cache OCLC responses in memory. Default 24 hours.
# Policy data changes slowly; longer cache = fewer API calls.
CACHE_TTL_SECONDS=86400
